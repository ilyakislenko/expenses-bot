# Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
NODE_ENV=development
PORT=3001

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=expenses_assistant_test
DB_PORT=5432
DB_CONTAINER_NAME=postgres-db

# Database URL (for local development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expenses_assistant_test

# pgAdmin Configuration
PGADMIN_CONTAINER_NAME=pgadmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
# Обязателен (docker-compose без значения по умолчанию); pgAdmin слушает только 127.0.0.1
PGADMIN_PASSWORD=change_me_long_random

# Grafana (docker-compose.monitoring.yml), обязателен
GF_SECURITY_ADMIN_PASSWORD=change_me_long_random

# Test Database Configuration
TEST_DB_HOST=localhost
TEST_DB_PORT=1337
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
TEST_DB_NAME=expenses_assistant_test
TEST_DB_CONTAINER_NAME=postgres-db

# Test Database Volume
TEST_DB_VOLUME_NAME=expenses_db_data

# Optional Configuration
LOG_LEVEL=info
MONITORING_PORT=3001
# Monitoring server has no auth: listens on 127.0.0.1 by default.
# Set 0.0.0.0 only if Prometheus scrapes from another host/container and the port is firewalled.
MONITORING_HOST=127.0.0.1
ADMIN_IDS=123456789,987654321
WEBHOOK_URL=https://your-domain.com/webhook 

# Receipt photo recognition — a chain of free AI providers. Slots RECEIPT_AI_1_*, RECEIPT_AI_2_*, … are tried in order;
# the next one is used only when the current one is unavailable (connect failure, 5xx/429/401/403, unexpected reply, timeout).
# No slots = feature off (the bot says so when a photo arrives). Slot fields:
#   PROVIDER — openai (any OpenAI-compatible /chat/completions: Ollama, Mistral, OpenRouter) or gemini (Google Gemini API)
#   BASE_URL — API base for openai (http://<ip>:11434/v1 for Ollama); MODEL — required for openai, gemini defaults to gemini-2.5-flash;
#   API_KEY — optional for Ollama, required for gemini; LOCAL_ADDRESS — source IP (Google is blocked from Russia: use an IP routed via VPN);
#   TIMEOUT_MS — whole request (default 60000; a model on a weak GPU may need 120000);
#   CONNECT_TIMEOUT_MS — TCP connect (default 2000, so a switched-off PC costs ~2 s).
#   CONCURRENCY — recognitions at once per slot (default 1 for LAN/loopback addresses, others wait in a queue;
#   0 = unlimited, the default for cloud slots).
# The old un-numbered RECEIPT_AI_PROVIDER/… settings still work as slot 1.
# Recommended: Ollama on a GPU PC → a cloud key (if any) → Ollama on the server.
# Ollama: `ollama pull qwen2.5vl:7b` (PC) / `qwen2.5vl:3b` (server); on the PC set OLLAMA_HOST=0.0.0.0, keep port 11434 LAN-only.
RECEIPT_AI_1_PROVIDER=openai
RECEIPT_AI_1_BASE_URL=http://192.168.1.50:11434/v1
RECEIPT_AI_1_MODEL=qwen2.5vl:7b
# RECEIPT_AI_2_PROVIDER=gemini
# RECEIPT_AI_2_API_KEY=
# RECEIPT_AI_2_LOCAL_ADDRESS=100.103.143.229
# or Mistral free tier: RECEIPT_AI_2_PROVIDER=openai, RECEIPT_AI_2_BASE_URL=https://api.mistral.ai/v1,
# RECEIPT_AI_2_MODEL=pixtral-12b-latest, RECEIPT_AI_2_API_KEY=
RECEIPT_AI_3_PROVIDER=openai
RECEIPT_AI_3_BASE_URL=http://127.0.0.1:11434/v1
RECEIPT_AI_3_MODEL=qwen2.5vl:3b
RECEIPT_AI_3_TIMEOUT_MS=120000

# «🤖 Спроси бота» — questions about the user's own money. The model only turns a question into a small JSON intent
# (numbers are computed by the bot); frequent phrasings are parsed without any model. Slots ASSISTANT_AI_1_*, … have the
# same fields as RECEIPT_AI_*. Not set = the receipt slots are reused (timeout capped by ASSISTANT_AI_TIMEOUT_MS,
# default 60000). Requests to the same local Ollama share one queue with receipts.
# ASSISTANT_AI_1_PROVIDER=off — no model, only the built-in parser for frequent questions.
# ASSISTANT_AI_TIMEOUT_MS=60000
# Voice messages → records, recognized locally by whisper.cpp (install steps: BOT_PAGES.md, «Голосовые»).
# Without VOICE_STT_BIN and VOICE_STT_MODEL (or if the files are missing) voice input is hidden.
VOICE_STT_BIN=/opt/whisper.cpp/build/bin/whisper-cli
VOICE_STT_MODEL=/opt/whisper.cpp/models/ggml-small.bin
VOICE_STT_THREADS=4
VOICE_STT_TIMEOUT_MS=90000
# VOICE_STT_FFMPEG=ffmpeg
# user (default) — the user's language, re-run with detection if nothing parses; auto — always detect (~5 s slower on CPU)
# VOICE_STT_LANGUAGE=user
