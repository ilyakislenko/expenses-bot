# Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
NODE_ENV=development
PORT=3001

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=expenses_assistant_test
DB_PORT=5432
DB_CONTAINER_NAME=postgres-db

# Database URL (for local development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expenses_assistant_test

# pgAdmin Configuration
PGADMIN_CONTAINER_NAME=pgadmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# Test Database Configuration
TEST_DB_HOST=localhost
TEST_DB_PORT=1337
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
TEST_DB_NAME=expenses_assistant_test
TEST_DB_CONTAINER_NAME=postgres-db

# Test Database Volume
TEST_DB_VOLUME_NAME=expenses_db_data

# Optional Configuration
LOG_LEVEL=info
MONITORING_PORT=3001
# Monitoring server has no auth: listens on 127.0.0.1 by default.
# Set 0.0.0.0 only if Prometheus scrapes from another host/container and the port is firewalled.
MONITORING_HOST=127.0.0.1
ADMIN_IDS=123456789,987654321
WEBHOOK_URL=https://your-domain.com/webhook 

# Receipt photo recognition (free AI providers). Empty key = feature off (the bot says so when a photo arrives).
# RECEIPT_AI_PROVIDER:
#   gemini — Google Gemini API (Google AI Studio key), default model gemini-2.5-flash;
#            blocked from Russia — set RECEIPT_AI_LOCAL_ADDRESS to an IP routed through a VPN
#   openai — any OpenAI-compatible /chat/completions; RECEIPT_AI_BASE_URL required
#            (OpenRouter https://openrouter.ai/api/v1, Mistral https://api.mistral.ai/v1, Ollama http://127.0.0.1:11434/v1 — no key)
#   github — GitHub Models (GitHub PAT; https://models.github.ai/inference, model openai/gpt-4o-mini).
#            Note: GitHub retired GitHub Models on 2026-07-30 — the endpoint answers with an "OK" stub
RECEIPT_AI_PROVIDER=gemini
RECEIPT_AI_API_KEY=
# Model (optional; required for openai), base URL (openai; overrides the github default)
RECEIPT_AI_MODEL=
RECEIPT_AI_BASE_URL=
# Source IP for outgoing AI requests (optional)
RECEIPT_AI_LOCAL_ADDRESS=
