BOT_TOKEN=your_telegram_bot_token_here
DATABASE_URL=postgresql://username:password@localhost:5432/expense_bot
PORT=3000
NODE_ENV=development
# Postgres по SSL (для управляемой БД в облаке); локальному Postgres в docker не нужно
DB_SSL=false
# Webhook вместо polling (только при npm start, т.е. NODE_ENV=production): домен, секрет заголовка, путь
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=
# Сервер метрик (/metrics, /health) без авторизации: по умолчанию только 127.0.0.1.
# 0.0.0.0 — если Prometheus собирает метрики с другой машины или из docker-контейнера (порт закрыть firewall'ом)
MONITORING_PORT=3001
MONITORING_HOST=127.0.0.1

# Распознавание фото чеков (бесплатные нейросети). Пусто — функция выключена, бот так и отвечает на фото.
# RECEIPT_AI_PROVIDER:
#   gemini — Google Gemini API (ключ из Google AI Studio), модель по умолчанию gemini-2.5-flash.
#            Из России недоступен — нужен RECEIPT_AI_LOCAL_ADDRESS, трафик с которого идёт через VPN
#   openai — любой OpenAI-совместимый /chat/completions: RECEIPT_AI_BASE_URL обязателен
#            (OpenRouter https://openrouter.ai/api/v1, Mistral https://api.mistral.ai/v1, Ollama http://127.0.0.1:11434/v1 — без ключа)
#   github — GitHub Models (GitHub PAT; https://models.github.ai/inference, модель openai/gpt-4o-mini).
#            Внимание: GitHub закрыл GitHub Models 30.07.2026 — адрес отвечает заглушкой «OK»
RECEIPT_AI_PROVIDER=gemini
RECEIPT_AI_API_KEY=
# Модель (необязательно; для openai — обязательно), адрес (openai; для github — переопределить адрес)
RECEIPT_AI_MODEL=
RECEIPT_AI_BASE_URL=
# Исходящий IP для запросов к нейросети (необязательно)
RECEIPT_AI_LOCAL_ADDRESS=
