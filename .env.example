BOT_TOKEN=your_telegram_bot_token_here
DATABASE_URL=postgresql://username:password@localhost:5432/expense_bot
PORT=3000
NODE_ENV=development
# Postgres по SSL (для управляемой БД в облаке); локальному Postgres в docker не нужно
DB_SSL=false
# Webhook вместо polling (только при npm start, т.е. NODE_ENV=production): домен, секрет заголовка, путь
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=
# Сервер метрик (/metrics, /health) без авторизации: по умолчанию только 127.0.0.1.
# 0.0.0.0 — если Prometheus собирает метрики с другой машины или из docker-контейнера (порт закрыть firewall'ом)
MONITORING_PORT=3001
MONITORING_HOST=127.0.0.1

# Распознавание фото чеков — цепочка бесплатных нейросетей. Слоты RECEIPT_AI_1_*, RECEIPT_AI_2_*, … пробуются по порядку;
# следующий берётся, только если текущий недоступен (не подключился, 5xx/429/401/403, не тот ответ, таймаут).
# Ни одного слота — функция выключена, бот так и отвечает на фото. Поля слота:
#   PROVIDER — openai (любой OpenAI-совместимый /chat/completions: Ollama, Mistral, OpenRouter) или gemini (Google Gemini API)
#   BASE_URL — адрес API для openai (http://<ip>:11434/v1 для Ollama); MODEL — модель (для openai обязательно,
#   gemini по умолчанию gemini-2.5-flash); API_KEY — ключ (Ollama не нужен; gemini — обязателен);
#   LOCAL_ADDRESS — исходящий IP (Google недоступен из России: IP, трафик с которого идёт через VPN);
#   TIMEOUT_MS — на весь запрос (60000 по умолчанию; модель на слабой видеокарте — 120000);
#   CONNECT_TIMEOUT_MS — на подключение (2000 по умолчанию: выключенный ПК стоит ~2 с).
# Старые RECEIPT_AI_PROVIDER/… без номера работают как слот 1.
# Рекомендуемая схема: Ollama на ПК с видеокартой → облачный ключ (если есть) → Ollama на сервере.
# Ollama: `ollama pull qwen2.5vl:7b` (ПК) / `qwen2.5vl:3b` (сервер); на ПК OLLAMA_HOST=0.0.0.0, порт 11434 открыть только в LAN.
RECEIPT_AI_1_PROVIDER=openai
RECEIPT_AI_1_BASE_URL=http://192.168.1.50:11434/v1
RECEIPT_AI_1_MODEL=qwen2.5vl:7b
# RECEIPT_AI_2_PROVIDER=gemini
# RECEIPT_AI_2_API_KEY=
# RECEIPT_AI_2_LOCAL_ADDRESS=100.103.143.229
# или Mistral (бесплатный тариф): RECEIPT_AI_2_PROVIDER=openai, RECEIPT_AI_2_BASE_URL=https://api.mistral.ai/v1,
# RECEIPT_AI_2_MODEL=pixtral-12b-latest, RECEIPT_AI_2_API_KEY=
RECEIPT_AI_3_PROVIDER=openai
RECEIPT_AI_3_BASE_URL=http://127.0.0.1:11434/v1
RECEIPT_AI_3_MODEL=qwen2.5vl:3b
RECEIPT_AI_3_TIMEOUT_MS=120000
